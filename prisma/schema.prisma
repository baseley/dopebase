generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                  String           @id @default(uuid())
  title               String?
  published           Boolean          @default(false)
  slug                String?          @unique
  isFree              Boolean?         @map("is_free")
  subtitle            String?
  allFeaturesHtml     String?          @map("all_features_html")
  appStoreDemoURL     String?          @map("app_store_demo_url")
  coverPhotoURL       String?          @map("cover_photo_url")
  demoVideoURL        String?          @map("demo_video_url")
  demoImageURL        String?          @map("demo_image_url")
  descriptionHtml     String?          @map("description_html")
  mainFeaturesHtml    String?          @map("main_features_html")
  playStoreDemoURL    String?          @map("play_store_demo_url")
  previewPhotoURLs    String[]         @map("preview_photo_urls")
  allPreviewsHtml     String?          @map("all_previews_html")
  secondSubtitle      String?          @map("second_subtitle")
  secondTitle         String?          @map("second_title")
  whatsIncludedHtml   String?          @map("whats_included_html")
  authorId            String?          @map("author_id")
  createdAt           String?          @map("created_at")
  updatedAt           String?          @map("updated_at")
  previewSectionTitle String?          @map("preview_section_title")
  seoKeyword          String?          @map("seo_keyword")
  seoTitle            String?          @map("seo_title")
  seoDescription      String?          @map("seo_description")
  url                 String?          @map("url")
  priority            Int              @default(0)
  featuredOnFrontPage Boolean          @default(true) @map("featured_on_front_page")
  isPremiumCodebase   Boolean?         @map("is_premium_codebase")
  isBundle            Boolean?         @map("is_bundle")
  isWebProduct        Boolean?         @default(false) @map("is_web_product")
  author              User?            @relation(fields: [authorId], references: [id])
  customerReviews     CustomerReview[]
  productVariants     ProductVariant[]
  freebieVariants     FreebieVariant[]
  tags                Tag[]

  @@map("products")
}

model ProductVariant {
  id             String           @id @default(uuid())
  price          String?
  fastspringSlug String?          @map("fastspring_slug")
  buyUrl         String?          @map("buy_url")
  createdAt      String?          @map("created_at")
  productId      String?          @map("product_id")
  updatedAt      String?          @map("updated_at")
  published      Boolean          @default(false)
  product        Product?         @relation(fields: [productId], references: [id])
  purchases      Purchase[]
  reviews        CustomerReview[]

  @@map("product_variants")
}

model FreebieVariant {
  id            String   @id @default(uuid())
  downloadURL   String?  @map("download_url")
  repositoryURL String?  @map("repository_url")
  productId     String?  @map("product_id")
  createdAt     String?  @map("created_at")
  updatedAt     String?  @map("updated_at")
  published     Boolean  @default(false)
  product       Product? @relation(fields: [productId], references: [id])

  FreebieDownload FreebieDownload[]

  @@map("freebie_variants")
}

model Purchase {
  id                       String          @id @default(uuid())
  licenseNo                String?         @unique @map("license_no")
  customerEmail            String?         @map("customer_email")
  fastspringOrderId        String?         @unique @map("fastspring_order_id")
  totalInPayoutCurrency    String?         @map("total_in_payout_currency")
  taxInPayoutCurrency      String?         @map("tax_in_payout_currency")
  netIncome                String?         @map("net_income")
  discountInPayoutCurrency String?         @map("discount_in_payout_currency")
  fastpringProductSlug     String?         @map("fastspring_product_slug")
  fastspringDownloadURL    String?         @map("fastspring_download_url")
  fastspringAccountID      String?         @map("fastspring_account_id")
  invoiceURL               String?         @map("invoice_url")
  localCurrency            String?         @map("local_currency")
  paymentType              String?         @map("payment_type")
  country                  String?         @map("country")
  status                   String?
  fastspringJSON           String?         @map("fastspring_json")
  createdAt                String?         @map("created_at")
  updatedAt                String?         @map("updated_at")
  variantId                String?         @map("variant_id")
  userId                   String?         @map("user_id")
  isRefund                 Boolean         @default(false) @map("is_refund")
  user                     User?           @relation(fields: [userId], references: [id])
  variant                  ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("purchases")
}

model FreebieDownload {
  id               String  @id @default(uuid())
  customerEmail    String? @map("customer_email")
  createdAt        String? @map("created_at")
  updatedAt        String? @map("updated_at")
  userId           String? @map("user_id")
  freebieVariantId String? @map("freebie_variant_id")

  user User? @relation(fields: [userId], references: [id])

  FreebieVariant FreebieVariant? @relation(fields: [freebieVariantId], references: [id])

  @@map("freebie_downloads")
}

model Auth {
  id                Int      @id @default(autoincrement())
  userId            String
  encryptedPassword String
  providerType      String   // 👈 ADDED THIS LINE
  resetToken        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id])
}


model User {
  id                String  @id @default(uuid())
  email             String? @unique
  createdAt         String? @map("created_at")
  updatedAt         String? @map("updated_at")
  encryptedPassword String? @map("encrypted_password")
  firstName         String? @map("first_name")
  lastName          String? @map("last_name")
  profilePictureURL String? @map("profile_picture_url")
  role              String?
  phone             String?
  resetToken        String? @map("reset_token")
  accessToken       String? @map("access_token")
  provider          String?
  metadata          String? @map("metadata")
  display_name      String?
  banned_at         DateTime? 

  username       String?
  bioTitle       String? @map("bio_title")
  bioDescription String? @map("bio_description")
  websiteURL     String? @map("website_url")
  banned         Boolean @default(false)

  auths          Auth[]
  customerReviews CustomerReview[]
  products        Product[]
  purchases       Purchase[]

  articles         Article[]
  freebieDownloads FreebieDownload[]
  tags             UserTag[]
  ticketThreads    TicketThread[]
  ticketMessages   TicketMessage[]

  repositories Repository[]
  userJobs     UserJob[]

  @@map("users")
}

model UserTag {
  id        String  @id @default(uuid())
  name      String?
  slug      String? @unique
  published Boolean @default(true)
  createdAt String? @map("created_at")
  updatedAt String? @map("updated_at")
  users     User[]

  @@map("user_tags")
}

model TagCategory {
  id            String        @id @default(uuid())
  name          String?
  slug          String?       @unique
  published     Boolean       @default(true)
  logoURL       String?       @map("logo_url")
  parentId      String?       @map("parent_id")
  createdAt     String?       @map("created_at")
  updatedAt     String?       @map("updated_at")
  tagCategory   TagCategory?  @relation("TagCategoryToTagCategory", fields: [parentId], references: [id])
  subcategories TagCategory[] @relation("TagCategoryToTagCategory")
  tags          Tag[]

  @@map("tag_categories")
}

model Tag {
  id             String       @id @default(uuid())
  name           String?
  slug           String?      @unique
  published      Boolean      @default(true)
  logoURL        String?      @map("logo_url")
  seoTitle       String?      @map("seo_title")
  seoDescription String?      @map("seo_description")
  tagCategoryId  String?      @map("tag_category_id")
  createdAt      String?      @map("created_at")
  updatedAt      String?      @map("updated_at")
  tagCategory    TagCategory? @relation(fields: [tagCategoryId], references: [id])
  products       Product[]

  @@map("tags")
}

model CustomerReview {
  id        String          @id @default(uuid())
  content   String?
  starCount Int?            @map("star_count")
  authorId  String?         @map("author_id")
  createdAt String?         @map("created_at")
  productId String?         @map("product_id")
  variantId String?         @map("variant_id")
  updatedAt String?         @map("updated_at")
  licenseNo String?         @map("license_no")
  published Boolean         @default(false)
  author    User?           @relation(fields: [authorId], references: [id])
  product   Product?        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("customer_reviews")
}

// Articles

model Article {
  id              String   @id @default(uuid())
  title           String?
  content         String?
  tableOfContents String?  @map("table_of_contents")
  coverPhoto      String?  @map("cover_photo")
  photoURLs       String[] @map("photo_urls")
  sourceCodeURL   String?  @map("source_code_url")
  canonicalURL    String?  @map("canonical_url")
  website         String?  @map("website")

  published Boolean @default(false)
  outdated  Boolean @default(false)

  slug           String? @unique
  seoKeyword     String? @map("seo_keyword")
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  authorId       String? @map("author_id")
  author         User?   @relation(fields: [authorId], references: [id])
  createdAt      String? @map("created_at")
  updatedAt      String? @map("updated_at")

  categoryId String?          @map("category_id")
  category   ArticleCategory? @relation(fields: [categoryId], references: [id])

  tags ArticleTag[]

  // AI fields
  aiContent        String? @map("ai_content")
  aiSections       String? @map("ai_sections")
  aiSeoDescription String? @map("ai_seo_description")
  aiSummary        String? @map("ai_summary")
  aiPrompt         String? @map("ai_prompt")
  aiTags           String? @map("ai_tags")
  aiSocialPost     String? @map("ai_social_post")
  aiGenerated      Boolean @default(false) @map("ai_generated")

  @@map("articles")
}

model ArticleTag {
  id             String  @id @default(uuid())
  name           String?
  slug           String? @unique
  description    String?
  published      Boolean @default(true)
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  seoImageURL    String? @map("seo_image_url")
  canonicalURL   String? @map("canonical_url")
  createdAt      String? @map("created_at")
  updatedAt      String? @map("updated_at")
  website        String? @map("website")

  products Article[]

  // AI fields
  aiSummary         String? @map("ai_summary")
  aiSeoDescription  String? @map("ai_seo_description")
  aiLongDescription String? @map("ai_long_description")
  aiSocialPost      String? @map("ai_social_post")
  aiPrompt          String? @map("ai_prompt")
  aiGenerated       Boolean @default(false) @map("ai_generated")

  @@map("article_tags")
}

model ArticleCategory {
  id             String  @id @default(uuid())
  name           String?
  description    String?
  slug           String? @unique
  logoURL        String? @map("logo_url")
  published      Boolean @default(false)
  createdAt      String? @map("created_at")
  updatedAt      String? @map("updated_at")
  parentId       String? @map("parent_id")
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  seoImageURL    String? @map("seo_image_url")
  canonicalURL   String? @map("canonical_url")

  parent          ArticleCategory?  @relation("ArticleCategoryToArticleCategory", fields: [parentId], references: [id])
  ArticleCategory ArticleCategory[] @relation("ArticleCategoryToArticleCategory")

  Article Article[]

  // AI fields
  aiSummary         String? @map("ai_summary")
  aiSeoDescription  String? @map("ai_seo_description")
  aiLongDescription String? @map("ai_long_description")
  aiSocialPost      String? @map("ai_social_post")
  aiPrompt          String? @map("ai_prompt")
  aiGenerated       Boolean @default(false) @map("ai_generated")

  @@map("article_categories")
}

// Emails

model EmailSubscriber {
  id           String               @id @default(uuid())
  email        String               @unique
  firstName    String?              @map("first_name")
  lastName     String?              @map("last_name")
  unsubscribed Boolean              @default(false)
  createdAt    String?              @map("created_at")
  updatedAt    String?              @map("updated_at")
  tags         EmailSubscriberTag[]

  @@map("email_subscribers")
}

model EmailSubscriberTag {
  id          String            @id @default(uuid())
  name        String?
  published   Boolean           @default(true)
  createdAt   String?           @map("created_at")
  updatedAt   String?           @map("updated_at")
  subscribers EmailSubscriber[]
  newsletters EmailNewsletter[]
  campaigns   EmailCampaign[]

  @@map("email_subscriber_tags")
}

model EmailCampaign {
  id             String               @id @default(uuid())
  title          String?
  active         Boolean              @default(true)
  published      Boolean              @default(false)
  createdAt      String?              @map("created_at")
  updatedAt      String?              @map("updated_at")
  emailSubject   String?              @map("email_subject")
  emailContent   String?              @map("email_content")
  trigger        String               @default("email_trigger_none")
  timingType     String               @default("immediately") @map("timing_type")
  delayInSeconds Int?                 @default(0) @map("delay_in_seconds")
  filters        EmailSubscriberTag[]
  emails         Email[]

  @@map("email_campaigns")
}

model EmailNewsletter {
  id                String               @id @default(uuid())
  title             String?
  emailSubject      String?              @map("email_subject")
  fromAddress       String?              @map("from_address")
  fromName          String?              @map("from_name")
  emailContent      String?              @map("email_content")
  status            String?
  totalRecipients   Int?                 @map("total_recipients")
  currentRecipients Int?                 @map("current_recipients")
  filters           EmailSubscriberTag[]
  createdAt         String?              @map("created_at")
  updatedAt         String?              @map("updated_at")

  @@map("email_newsletters")
}

model EmailSettings {
  id          String  @id @default(uuid())
  displayName String  @default("") @map("display_name")
  key         String?
  value       String?

  @@map("email_settings")
}

model Email {
  id           String         @id @default(uuid())
  token        String?        @unique
  to           String?
  from         String?
  subject      String?
  content      String?
  createdAt    String?        @map("created_at")
  markedAsRead Boolean        @default(false) @map("marked_as_read")
  markedAsOpen Boolean        @default(false) @map("marked_as_open")
  sendAt       String?        @map("send_at")
  campaignId   String?        @map("campaign_id")
  campaign     EmailCampaign? @relation(fields: [campaignId], references: [id])

  @@map("emails")
}

model JobQueue {
  id        String  @id @default(uuid())
  type      String? @map("type")
  data      String? @map("data")
  status    String? @map("status")
  priority  String? @map("priority")
  startTime String? @map("start_time")
  createdAt String? @map("created_at")
  updatedAt String? @map("updated_at")

  @@map("job_queue")
}

// Customer Support

model TicketThread {
  id           String  @id @default(uuid())
  number       Int?    @unique
  authorEmail  String? @map("author_email")
  authorName   String? @map("author_name")
  messageCount Int?    @map("message_count")
  subject      String?
  isClosed     Boolean @default(false) @map("is_closed")
  isPublic     Boolean @default(false) @map("is_public")
  createdAt    String? @map("created_at")
  updatedAt    String? @map("updated_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  messages TicketMessage[]
  tags     TicketTag[]

  @@map("ticket_threads")
}

model TicketMessage {
  id                 String        @id @default(uuid())
  senderEmail        String?       @map("author_email")
  fromOriginalPoster Boolean       @default(false) @map("from_original_poster")
  message            String?
  threadId           String?       @map("thread_id")
  thread             TicketThread? @relation(fields: [threadId], references: [id])

  userId    String? @map("user_id")
  user      User?   @relation(fields: [userId], references: [id])
  createdAt String? @map("created_at")
  updatedAt String? @map("updated_at")

  @@map("ticket_messages")
}

model TicketTag {
  id        String         @id @default(uuid())
  name      String?
  slug      String?        @unique
  published Boolean        @default(true)
  createdAt String?        @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tickets   TicketThread[]

  @@map("ticket_tags")
}

// Devassist
model Repository {
  id        String  @id @default(uuid())
  title     String?
  url       String?
  private   Boolean @default(false)
  userId    String? @map("user_id")
  createdAt String? @map("created_at")
  updatedAt String? @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("respositories")
}

model UserJob {
  id        String  @id @default(uuid())
  type      String? @map("type")
  data      String? @map("data")
  status    String? @map("status")
  priority  String? @map("priority")
  startTime String? @map("start_time")
  userId    String? @map("user_id")
  createdAt String? @map("created_at")
  updatedAt String? @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("user_jobs")
}

model ArticleIdea {
  id             String  @id @default(uuid())
  title          String? @map("title")
  sections       String? @map("sections")
  tags           String? @map("tags")
  status         String? @map("status")
  extraPrompt    String? @map("extra_prompt")
  slug           String? @map("slug")
  tweet          String? @map("tweet")
  seoDescription String? @map("seo_description")
  summary        String? @map("summary")
  topic          String? @map("topic")
  website        String? @map("website")
  category       String? @map("category")
  createdAt      String? @map("created_at")
  updatedAt      String? @map("updated_at")

  @@map("article_ideas")
}

model Plugin {
  id         String   @id @default(uuid())
  name       String
  installed  Boolean  @default(false)
  createdAt  String
  updatedAt  String
}



model Settings {
  id         String  @id @default(uuid())
  name       String
  key        String?
  value      String
  created_at String? @map("created_at")
  updated_at String? @map("updated_at")
  pluginId   String? @map("plugin_id")

  @@map("settings")
}

model PaymentMethod {
  id                 String   @id @default(uuid())
  provider           String
  details            String?
  default            Boolean  @default(false) @map("is_default")
  userId             String    @map("userid")
  brand              String?   
  last4Digits        String?  @map("last4") 
  expiryMonth        String?  @map("expirymonth")
  expiryYear         String?  @map("expiryyear")
  stripeCustomerId   String?  @map("stripecustomerid")
  cardInformation    String?
  expiryDate         String?
  user               String
  createdAt          String?  @map("created_at")
  updatedAt          String?  @map("updated_at")
  
  @@map("payment_methods")
}



model TaxiCarCategory {
  id               String   @id @default(uuid())
  name             String
  description      String?
  carPhoto         String?  @map("car_photo")     
  carMarkerIcon    String?  @map("car_marker_icon") 
  baseFare         Float    @map("base_fare")      
  costPerKm        Float    @map("cost_per_km")     
  costPerMin       Float    @map("cost_per_min")    
  minimumFare      Float    @map("minimum_fare")    
  maxPassengers    Int      @map("max_passengers")  
  createdAt        String?  @map("created_at")      
  updatedAt        String?  @map("updated_at")      
  
  @@map("taxi_car_categories")
}


model TaxiTrips {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("taxi_trips")
}


// this might not be the exact schema values
model Post {
  id        String   @id @default(uuid())
  title     String
  content   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("posts") // <- this must match
}

model Story {
  id        String   @id @default(uuid())
  title     String
  content   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stories")
}

model SubscriptionPlan {
  id                 String   @id @default(uuid())
  name               String   @map("name") // Basic Description
  shortDescription   String   @map("basic_description")
  detailedDescription String  @map("detailed_description")
  price              Float
  stripePriceId      String   @map("stripe_price_id")
  billingCycle       String   @map("billing_cycle")
  createdAt          String?  @map("created_at")
  updatedAt          String?  @map("updated_at")

  @@map("subscription_plans")
}


model Subscription {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  planId        String    @map("plan_id")
  startDate     String?   @map("start_date")
  endDate       String?   @map("end_date")
  status        String    @map("status")
  lastPayment   String?   @map("last_payment")
  nextBilling   String?   @map("next_billing")
  createdAt     String?   @map("created_at")
  updatedAt     String?   @map("updated_at")

  @@map("subscriptions")
}

model Transaction {
  id               String   @id @default(uuid())
  subscriptionId   String   @map("subscription_id")
  providerTransactionId String   @map("provider_transaction_id")
  amount           String   @map("amount")
  transactionDate  String   @map("transaction_date")
  status           String   @map("status")
  providerId       String   @map("provider_id")
  createdAt        String   @map("created_at")
  updatedAt        String   @map("updated_at")

  @@map("transactions")
}

